# Copy this to .env for local dev and fill in real values.
# .env is gitignored — never commit real secrets.
# In production (Cloud Run), these same names come from Google Secret Manager instead.

SECRET_KEY=change-me-to-a-real-random-secret-key
DEBUG=True

# Supabase Postgres connection string (Project Settings → Database → Connection string → URI)
DATABASE_URL=postgres://user:password@host:5432/postgres

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Supabase Storage (Project Settings → API) — used to sign document upload/download URLs.
# Service role key stays server-side only, never sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_STORAGE_BUCKET=admissions-documents

# Document upload limits (Application form). Enforced client-side, server-side
# (upload-url request), and on the bucket itself — run
# `manage.py configure_storage_bucket` after changing this so the bucket's
# own file_size_limit stays in sync (allowed types are hardcoded, see
# admissions/storage.py ALLOWED_UPLOAD_EXTENSIONS).
MAX_UPLOAD_SIZE_MB=10

# Email — Resend via SMTP relay once RESEND_API_KEY is set; console
# backend (prints to stdout, sends nothing) while it's empty, so local dev
# needs no real credentials. DEFAULT_FROM_EMAIL's domain must be a verified
# sending domain in Resend before real sends will succeed.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=admissions@tcsch.edu.gh
ADMISSIONS_STAFF_EMAIL=admissions@tcsch.edu.gh

# Phase 3 — offers. No scheduler exists yet, so expiry is resolved lazily on
# read rather than by a timed job (see Offer.refresh_expiry()).
OFFER_EXPIRY_DAYS=14

# Base URL used to build the accept/decline link in the offer email. The
# /inquiry, /apply, /offer forms are served by this Django app itself, so
# this points at the Django dev server for dev; set to the real subdomain
# (e.g. https://admissions.tcsch.edu.gh) in production.
FRONTEND_BASE_URL=http://127.0.0.1:8000
